                <h3 class="rvcard__name">{r.title}</h3>
                <span class="rvcard__cta">Read review →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Footer
    authorName={author?.name}
    authorAvatar={authorAvatar}
    authorBio={author?.description ? strip(author.description) : null}
    authorSlug={authorSlug}
    socials={socials}
  />
</Layout>

