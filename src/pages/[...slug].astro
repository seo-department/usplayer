---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"
import Breadcrumbs from "../components/Breadcrumbs.astro"

const STAGING = "https://wordpress-1301750-6506622.cloudwaysapps.com"

const REVIEWER_BIOS: Record<string, string> = {
  "Evans Bonnie": "Evans Bonnie is a senior casino industry researcher who verifies licensing details, payout data, and bonus terms to ensure every review meets the site's accuracy standards.",
  Bonnie: "Evans Bonnie is a senior casino industry researcher who verifies licensing details, payout data, and bonus terms to ensure every review meets the site's accuracy standards.",

  "Charlotte Watts": "Charlotte Watts is a meticulous fact-checker specializing in online gambling regulations, cross-referencing every claim against official licensing bodies before publication.",
  Charlotte: "Charlotte Watts is a meticulous fact-checker specializing in online gambling regulations, cross-referencing every claim against official licensing bodies before publication.",

  "Jordie Hillcreek": "Jordie Hillcreek is a dedicated fact-checker and casino industry researcher, verifying licensing, payout data, and bonus terms to keep every review accurate and trustworthy.",
  Jordie: "Jordie Hillcreek is a dedicated fact-checker and casino industry researcher, verifying licensing, payout data, and bonus terms to keep every review accurate and trustworthy.",

  "Margaret Cooper": "Margaret Cooper brings a sharp eye for detail to every review, fact-checking payout speeds, wagering requirements, and licensing information before anything goes live.",
  Margaret: "Margaret Cooper brings a sharp eye for detail to every review, fact-checking payout speeds, wagering requirements, and licensing information before anything goes live.",

  "Kayla McBrien": "Kayla McBrien is a rare breed of iGaming professional — combining deep technical know-how from her former career as a software engineer with sharp analytical insight as a senior casino analyst.",
}

const escapeName = (name: string) => name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")

function injectTooltip(html: string, name: string | null | undefined, bio: string | null | undefined) {
  if (!html || !name || !bio) return html
  const re = new RegExp(`(<a[^>]*>)(\\s*${escapeName(name)}\\s*)(</a>)`, "i")
  return html.replace(re, (_m, open, text, close) =>
    `<span class="author-tooltip-wrap">${open}${text}${close}<span class="author-tooltip-popup">${bio}</span></span>`,
  )
}

export async function getStaticPaths() {
  const STAGING = "https://wordpress-1301750-6506622.cloudwaysapps.com"

  const endpoint = import.meta.env.WP_GRAPHQL_URL || `${STAGING}/graphql`

  console.log("[wp] Fetching data from:", endpoint)

  const MEDIA = (import.meta.env.WP_MEDIA_URL ?? STAGING).replace(/\/$/, "")
  const mediaUrl = u => (u ? u.replaceAll(STAGING, MEDIA) : u)

  const safeHeaders = {
    "Content-Type": "application/json",
    "User-Agent":
      "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  }

  const POST_FIELDS = `title slug uri date modified excerpt content
    featuredImage { node { sourceUrl altText } }
    categories(first: 3) { nodes { name } }
    author { node { name description url avatar { url } } }`

  const PAGE_FIELDS = `title slug uri date modified content isFrontPage
  featuredImage { node { sourceUrl altText } }
  author { node { name description url avatar { url } } }`

  // Temporarily removed the reviewFields sub-query — it references a field
  // name ("reviewFields") that doesn't exist on the CasinoReview type in
  // WPGraphQL, which was crashing the entire build and causing every page
  // (not just reviews) to 404. Re-add once we confirm the correct ACF
  // field group name from the WPGraphQL schema docs.
  const REVIEW_FIELDS = `title slug uri date modified content
  featuredImage { node { sourceUrl altText } }
  author { node { name description url avatar { url } } }`

  async function fetchAll(root, fields) {
    const items = []
    let after = null
    for (let i = 0; i < 50; i++) {
      const query = `query($after: String) {
        ${root}(first: 100, after: $after) {
          pageInfo { hasNextPage endCursor }
          nodes { ${fields} }
        }
      }`
      let json
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: safeHeaders,
          body: JSON.stringify({ query, variables: { after } }),
        })
        json = await res.json()
      } catch (e) {
        console.error(`[wp] ${root} network error:`, e)
        break
      }
      if (json.errors) {
        console.error(
          `[wp] ${root} GraphQL errors:`,
          JSON.stringify(json.errors, null, 2),
        )
        break
      }
      const conn = json.data?.[root]
      if (!conn) break
      items.push(...(conn.nodes ?? []))
      if (!conn.pageInfo?.hasNextPage) break
      after = conn.pageInfo.endCursor
    }
    return items
  }

  const [posts, pages, reviews] = await Promise.all([
    fetchAll("posts", POST_FIELDS),
    fetchAll("pages", PAGE_FIELDS),
    fetchAll("casinoReviews", REVIEW_FIELDS),
  ])
  console.log(
    "[wp] fetched posts:", posts.length,
    " pages:", pages.length,
    " reviews:", reviews.length,
  )

  const clean = (uri, slug) => (uri || `/${slug}/`).replace(/^\/+|\/+$/g, "")
  const stripText = h =>
    (h ?? "")
      .replace(/<[^>]+>/g, "")
      .replace(/&hellip;/g, "…")
      .trim()
  const readOf = html =>
    Math.max(
      1,
      Math.ceil(stripText(html).split(/\s+/).filter(Boolean).length / 200),
    )

  const toCard = p => ({
    title: p.title,
    href: "/" + clean(p.uri, p.slug) + "/",
    img: mediaUrl(p.featuredImage?.node?.sourceUrl ?? null),
    alt: p.featuredImage?.node?.altText ?? p.title,
    cat: p.categories?.nodes?.[0]?.name ?? "News",
    author: p.author?.node?.name ?? null,
    avatar: mediaUrl(p.author?.node?.avatar?.url ?? null),
    read: `${readOf(p.content)} min read`,
  })
  const relatedFor = current => {
    const curCats = new Set((current.categories?.nodes ?? []).map(c => c.name))
    const others = posts.filter(p => p !== current)
    const same = others.filter(p =>
      (p.categories?.nodes ?? []).some(c => curCats.has(c.name)),
    )
    const rest = others.filter(p => !same.includes(p))
    return [...same, ...rest].slice(0, 3).map(toCard)
  }

  const toReviewCard = r => ({
    title: r.title,
    href: "/" + clean(r.uri, r.slug) + "/",
    logo: mediaUrl(r.featuredImage?.node?.sourceUrl ?? null),
    alt: r.featuredImage?.node?.altText ?? r.title,
  })
  const relatedReviews = current =>
    reviews
      .filter(r => r !== current)
      .slice(0, 3)
      .map(toReviewCard)

  const paths = []
  const seen = new Set()
  for (const node of posts) {
    const slug = clean(node.uri, node.slug)
    if (!slug || seen.has(slug)) continue
    seen.add(slug)
    paths.push({
      params: { slug },
      props: { type: "post", node, related: relatedFor(node) },
    })
  }
  for (const node of reviews) {
    const slug = clean(node.uri, node.slug)
    if (!slug || seen.has(slug)) continue
    seen.add(slug)
    paths.push({
      params: { slug },
      props: { type: "review", node, related: relatedReviews(node) },
    })
  }
  for (const node of pages) {
    let slug = clean(node.uri, node.slug)

    // Relocate the WordPress front page to /online-casinos
    // (its uri is "/" which cleans to an empty slug and would collide with the Astro homepage)
    if (node.isFrontPage || slug === "") {
      slug = "online-casinos"
    }

    if (!slug || seen.has(slug)) continue
    seen.add(slug)
    paths.push({ params: { slug }, props: { type: "page", node, related: [] } })
  }
  return paths
}

const { type, node, related = [] } = Astro.props
const isPost = type === "post"
const isReview = type === "review"

const MEDIA = (import.meta.env.WP_MEDIA_URL ?? STAGING).replace(/\/$/, "")
const mediaUrl = u => (u ? u.replaceAll(STAGING, MEDIA) : u)

const rewriteMedia = html =>
  (html ?? "")
    .replaceAll(STAGING, MEDIA)
    .replace(/(["'\s(,])\/wp-(content|includes)\//g, `$1${MEDIA}/wp-$2/`)
    .replace(
      /<script[^>]*type=["']application\/ld\+json["'][^>]*>[\s\S]*?<\/script>/gi,
      "",
    )

const strip = h =>
  (h ?? "")
    .replace(/<[^>]+>/g, "")
    .replace(/&hellip;/g, "…")
    .trim()
const fmtDate = d =>
  d
    ? new Date(d).toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      })
    : ""

const title = node.title
let contentHtml = rewriteMedia(node.content)

if (author?.name && author?.description) {
  contentHtml = injectTooltip(contentHtml, author.name, strip(author.description))
}

// Try to match any hardcoded reviewer name that appears in this page's content
for (const [reviewerName, bio] of Object.entries(REVIEWER_BIOS)) {
  contentHtml = injectTooltip(contentHtml, reviewerName, bio)
}

const description = strip(node.excerpt) || strip(node.content).slice(0, 155)
const heroImage = mediaUrl(node.featuredImage?.node?.sourceUrl ?? null)
const heroAlt = node.featuredImage?.node?.altText ?? title

const author = node.author?.node ?? null
const authorUrl = mediaUrl(author?.url ?? null)

// Manual avatar overrides — keyed by exact WP display name.
// Paths are root-relative (no domain) so they work on localhost,
// Vercel preview URLs, and production alike.
const manualAvatars: Record<string, string> = {
  "Evans Bonnie": "/wp-content/uploads/2024/08/bonnie-evans.png",
  Bonnie: "/wp-content/uploads/2024/08/bonnie-evans.png",
  "Charlotte Watts": "/wp-content/uploads/2025/09/charlotte-watts.png",
  Charlotte: "/wp-content/uploads/2025/09/charlotte-watts.png",
  "Jordie Hillcreek": "/wp-content/uploads/2024/08/Jordie-Hillcreek.png",
  Jordie: "/wp-content/uploads/2024/08/Jordie-Hillcreek.png",
  "Margaret Cooper": "/wp-content/uploads/2024/07/Margaret-Cooper-us.webp",
  Margaret: "/wp-content/uploads/2024/07/Margaret-Cooper-us.webp",
}

const isDefaultWpAvatar = (url: string | null | undefined) =>
  !url || /mystery-man|gravatar\.com\/avatar\/.*d=mm/i.test(url)

const authorAvatar =
  (author?.name && manualAvatars[author.name]) ||
  (!isDefaultWpAvatar(author?.avatar?.url)
    ? mediaUrl(author.avatar.url)
    : null) ||
  (author?.name
    ? `https://ui-avatars.com/api/?name=${encodeURIComponent(author.name)}&background=1a233a&color=fff&bold=true`
    : null)

const cat = node.categories?.nodes?.[0]?.name ?? null
const published = fmtDate(node.date)
const updated = fmtDate(node.modified)
const words = strip(node.content).split(/\s+/).filter(Boolean).length
const readTime = Math.max(1, Math.ceil(words / 200))
const canonical = new URL(Astro.url.pathname, Astro.site).toString()

const visitUrl = `https://goto.usplayercheck.com/${node.slug}.home`

const rf = node.reviewFields ?? {}
const rating = rf.rating != null && rf.rating !== "" ? Number(rf.rating) : null
const promoHeadline = rf.promoHeadline ?? null
const promoDescription = strip(rf.promoDescription ?? "")

const socials = []
if (authorUrl) socials.push({ network: "website", url: authorUrl })

const socialIcon = {
  website:
    '<path d="M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.5 2.5 15.5 0 18M12 3c-2.5 2.5-2.5 15.5 0 18" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  twitter:
    '<path d="M4 4l7 9-7 7h2.5l5.5-5.5L16 20h4l-7.3-9.4L19.5 4H17l-5 5L8 4z" fill="currentColor"/>',
  facebook:
    '<path d="M14 7h2V4h-2.5C11 4 10 5.6 10 7.5V9H8v3h2v8h3v-8h2.2l.8-3H13V7.6c0-.4.3-.6.7-.6z" fill="currentColor"/>',
  linkedin:
    '<path d="M6 9v9M6 6v.01M10 18v-5a2 2 0 014 0v5M10 12v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
}

const trustIcon = {
  shield:
    '<path d="M12 2l8 3v6.5c0 5-3.4 8.8-8 10.5-4.6-1.7-8-5.5-8-10.5V5l8-3z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8.3 12l2.6 2.6 4.8-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  lock: '<rect x="4" y="10" width="16" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.8"/>',
  check:
    '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 12l2 2 4-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
}

const slugifyHeading = text =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "")

const tocItems: { text: string; slug: string }[] = []
contentHtml = contentHtml.replace(
  /<h2([^>]*)>([\s\S]*?)<\/h2>/gi,
  (match, attrs, inner) => {
    const cleanText = strip(inner)
    if (!cleanText) return match
    const headingSlug = slugifyHeading(cleanText)
    tocItems.push({ text: cleanText, slug: headingSlug })
    if (/\sid=/.test(attrs)) return match
    return `<h2${attrs} id="${headingSlug}">${inner}</h2>`
  },
)

const siteUrl = "https://usplayercheck.com"

function slugify(str) {
  return (str || "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "")
}

const crumbItems = isReview
  ? [
      { label: "Home", href: "/" },
      { label: "Casino Reviews", href: "/casino-reviews/" },
      { label: title },
    ]
  : isPost
    ? [
        { label: "Home", href: "/" },
        ...(cat ? [{ label: cat, href: `/category/${slugify(cat)}/` }] : []),
        { label: title },
      ]
    : [{ label: "Home", href: "/" }, { label: title }]

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonical}#breadcrumb`,
  itemListElement: crumbItems.map((crumb, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: crumb.label,
    item: crumb.href ? `${siteUrl}${crumb.href}` : canonical,
  })),
}

const authorSlug = author?.name ? slugify(author.name) : null
const authorPerson = author?.name
  ? {
      "@type": "Person",
      "@id": authorSlug
        ? `${siteUrl}/about-us/${authorSlug}/#person`
        : `${canonical}#author`,
      name: author.name,
      ...(authorSlug ? { url: `${siteUrl}/about-us/${authorSlug}/` } : {}),
      ...(authorAvatar ? { image: authorAvatar } : {}),
      ...(author.description ? { description: strip(author.description) } : {}),
      
      // --- NEW RICH PERSON SCHEMA FIELDS ---
      jobTitle: "Content Contributor", // Feel free to adjust this fallback title
      worksFor: {
        "@type": "Organization",
        name: "US Player Check",
        url: siteUrl
      },
      // Automatically populates social media and website links into the schema
      ...(socials.length > 0 ? { sameAs: socials.map(s => s.url) } : {})
    }
  : null

const isPage = type === "page"

const articleSchema = (isPost || isPage)
  ? {
      "@type": "Article",
      "@id": `${canonical}#article`,
      headline: title,
      description,
      datePublished: node.date,
      dateModified: node.modified,
      mainEntityOfPage: canonical,
      ...(heroImage ? { image: [heroImage] } : {}),
      ...(authorPerson ? { author: { "@id": authorPerson["@id"] } } : {}),
      publisher: {
        "@type": "Organization",
        name: "US Player Check",
        logo: {
          "@type": "ImageObject",
          url: `${siteUrl}/images/usplayercheck-blue_logo.png`,
        },
      },
    }
  : null

const reviewSchema = isReview
  ? {
      "@type": "Review",
      "@id": `${canonical}#review`,
      name: title,
      url: canonical,
      datePublished: node.date,
      dateModified: node.modified,
      ...(heroImage ? { image: [heroImage] } : {}),
      itemReviewed: {
        "@type": "Organization",
        name: title.replace(/\s*review.*$/i, "").trim(),
        ...(heroImage ? { image: heroImage } : {}),
      },
      author: authorPerson
        ? { "@id": authorPerson["@id"] }
        : { "@type": "Organization", name: "US Player Check" },
      publisher: { "@type": "Organization", name: "US Player Check" },
      ...(rating != null
        ? {
            reviewRating: {
              "@type": "Rating",
              ratingValue: rating,
              bestRating: "5",
              worstRating: "0",
            },
          }
        : {}),
    }
  : null

const faqPairs = []
const faqRegex =
  /class="[^"]*panel-title[^"]*"[^>]*>([\s\S]*?)<\/(?:a|div|button)>[\s\S]*?class="[^"]*panel-body[^"]*"[^>]*>([\s\S]*?)<\/div>/gi
let faqMatch
while ((faqMatch = faqRegex.exec(contentHtml)) !== null) {
  const q = strip(faqMatch[1])
  const a = strip(faqMatch[2])
  if (q && a) faqPairs.push({ question: q, answer: a })
}

const faqSchema =
  faqPairs.length > 0
    ? {
        "@type": "FAQPage",
        "@id": `${canonical}#faq`,
        mainEntity: faqPairs.map(({ question, answer }) => ({
          "@type": "Question",
          name: question,
          acceptedAnswer: { "@type": "Answer", text: answer },
        })),
      }
    : null

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    authorPerson,
    breadcrumbSchema,
    articleSchema,
    reviewSchema,
    faqSchema,
  ].filter(Boolean),
}
---

<Layout
  title={`${title} – US Player Check`}
  description={description}
  image={heroImage ?? "/og-default.png"}
>
  <Nav />
  <Breadcrumbs items={crumbItems} />

  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  {
    isReview ? (
      <article class="entry rentry">
        <header class="rband">
          <div class="wrap rband__inner">
            {heroImage && (
              <div class="rband__logo">
                <img src={heroImage} alt={heroAlt} loading="lazy" />
                {rating != null && (
                  <span class="rband__rating">
                    {rating.toFixed(1)}{" "}
                    <svg
                      viewBox="0 0 20 20"
                      width="12"
                      height="12"
                      aria-hidden="true"
                    >
                      <path
                        d="M10 1.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L10 15.9l-5.25 2.6 1-5.85L1.5 7.65l5.9-.85z"
                        fill="currentColor"
                      />
                    </svg>
                  </span>
                )}
              </div>
            )}

            <div class="rband__text">
              <h1 class="rband__title">{title}</h1>
              {promoHeadline && (
                <p class="rband__promo" set:html={promoHeadline} />
              )}
              {promoDescription && (
                <p class="rband__terms">{promoDescription}</p>
              )}
            </div>

            <div class="rband__cta">
              <a
                class="btn btn-emerald rband__btn"
                href={visitUrl}
                rel="nofollow sponsored noopener"
                target="_blank"
              >
                Sign Up →
              </a>
              <span class="rband__note">New players only · 18+</span>
            </div>
          </div>
        </header>

        {tocItems.length > 0 && (
          <div class="wrap">
            <nav class="toc" aria-label="Table of contents">
              <button class="toc__toggle" type="button" aria-expanded="false">
                <span>Table of Contents</span>
                <span class="toc__badge">Show</span>
              </button>
              <ul class="toc__list" hidden>
                {tocItems.map((item: { text: string; slug: string }) => (
                  <li>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}

        <div class="wrap rentry__grid">
          <div class="prose" id="review-body" set:html={contentHtml} />
          <aside class="rsidebar" aria-label="Quick summary">
            <div class="rsidebar__card">
              {heroImage && (
                <img
                  class="rsidebar__logo"
                  src={heroImage}
                  alt={heroAlt}
                  loading="lazy"
                />
              )}
              <span class="rsidebar__label">Our verdict</span>
              <p class="rsidebar__name">
                {title.replace(/\s*review.*$/i, "").trim()}
              </p>
              <dl class="rsidebar__facts">
                <div>
                  <dt>Reviewed</dt>
                  <dd>{published}</dd>
                </div>
                {updated && updated !== published && (
                  <div>
                    <dt>Updated</dt>
                    <dd>{updated}</dd>
                  </div>
                )}
                <div>
                  <dt>Status</dt>
                  <dd>Accepting US players</dd>
                </div>
              </dl>

              <a
                class="btn btn-gold rsidebar__cta"
                href={visitUrl}
                rel="nofollow sponsored noopener"
                target="_blank"
              >
                Visit Casino
              </a>
              <span class="rsidebar__note">
                18+ · Terms apply · Gamble responsibly
              </span>
            </div>
          </aside>
        </div>
      </article>
    ) : isPost ? (
      <article class="entry">
        <header class="phero">
          <div class="phero__glow" aria-hidden="true" />
          <div class="wrap phero__inner">
            {cat && <span class="phero__cat">{cat}</span>}
            <h1 class="phero__title">{title}</h1>

            <div class="byline">
              {authorAvatar && (
                <img
                  class="byline__avatar"
                  src={authorAvatar}
                  alt={author?.name ?? "Author"}
                  width="44"
                  height="44"
                  loading="lazy"
                />
              )}
              <div class="byline__text">
                {author?.name && (
                  <span class="byline__name">{author.name}</span>
                )}
                <span class="byline__meta">
                  {published}
                  {updated && updated !== published
                    ? ` · Updated ${updated}`
                    : ""}
                  {` · ${readTime} min read`}
                </span>
              </div>
            </div>
          </div>
        </header>

        {tocItems.length > 0 && (
          <div class="wrap">
            <nav class="toc" aria-label="Table of contents">
              <button class="toc__toggle" type="button" aria-expanded="false">
                <span>Table of Contents</span>
                <span class="toc__badge">Show</span>
              </button>
              <ul class="toc__list" hidden>
                {tocItems.map((item: { text: string; slug: string }) => (
                  <li>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}

        {heroImage && (
          <div class="wrap">
            <img
              class="entry__cover"
              src={heroImage}
              alt={heroAlt}
              width="1200"
              height="630"
              loading="lazy"
            />
          </div>
        )}

        <div class="wrap">
          <div class="prose" set:html={contentHtml} />
        </div>

        {author && (
          <div class="wrap">
            <aside class="authorcard">
              {authorAvatar && (
                <img
                  class="authorcard__avatar"
                  src={authorAvatar}
                  alt={author.name}
                  width="72"
                  height="72"
                  loading="lazy"
                />
              )}
              <div class="authorcard__body">
                <span class="authorcard__label">Written by</span>
                <h2 class="authorcard__name">{author.name}</h2>
                {author.description && (
                  <p class="authorcard__bio">{author.description}</p>
                )}
                {socials.length > 0 && (
                  <div class="authorcard__socials">
                    {socials.map(s => (
                      <a
                        href={s.url}
                        target="_blank"
                        rel="noopener"
                        aria-label={s.network}
                      >
                        <svg
                          viewBox="0 0 24 24"
                          width="18"
                          height="18"
                          set:html={socialIcon[s.network] ?? socialIcon.website}
                        />
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </aside>
          </div>
        )}
      </article>

    ) : (
      <article class="entry">
        <header class="ghero">
          <div class="wrap">
            <h1 class="ghero__title">{title}</h1>
          </div>
        </header>

        {tocItems.length > 0 && (
          <div class="wrap">
            <nav class="toc" aria-label="Table of contents">
              <button class="toc__toggle" type="button" aria-expanded="false">
                <span>Table of Contents</span>
                <span class="toc__badge">Show</span>
              </button>
              <ul class="toc__list" hidden>
                {tocItems.map((item: { text: string; slug: string }) => (
                  <li>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}

        <div class="wrap">
          <div class="prose" set:html={contentHtml} />
        </div>
      </article>
    )
  }

  {
    isPost && related.length > 0 && (
      <section class="related">
        <div class="wrap">
          <h2 class="related__title">Related reading</h2>
          <div class="related__grid">
            {related.map(r => (
              <a class="rcard" href={r.href}>
                <div class="rcard__media">
                  {r.img && (
                    <img
                      class="rcard__img"
                      src={r.img}
                      alt={r.alt}
                      loading="lazy"
                    />
                  )}
                  <span class="rcard__cat">{r.cat}</span>
                </div>
                <h3 class="rcard__title">{r.title}</h3>
                <div class="rcard__by">
                  {r.avatar && (
                    <img
                      class="rcard__avatar"
                      src={r.avatar}
                      alt={r.author}
                      width="24"
                      height="24"
                      loading="lazy"
                    />
                  )}
                  {r.author && <span class="rcard__author">{r.author}</span>}
                  <span class="rcard__meta">· {r.read}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    isReview && related.length > 0 && (
      <section class="related">
        <div class="wrap">
          <h2 class="related__title">Related casino reviews</h2>
          <div class="related__grid related__grid--reviews">
            {related.map(r => (
              <a class="rvcard" href={r.href}>
                <div class="rvcard__logo">
                  {r.logo && <img src={r.logo} alt={r.alt} loading="lazy" />}
