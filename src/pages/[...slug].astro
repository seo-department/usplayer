<script>
  function initTocToggles() {
    document.querySelectorAll(".toc__toggle").forEach(btn => {
      if (btn.dataset.tocBound === "true") return // prevent double-binding
      btn.dataset.tocBound = "true"

      btn.addEventListener("click", () => {
        const list = btn.parentElement.querySelector(".toc__list")
        if (!list) return

        const isHidden = list.hasAttribute("hidden")
        if (isHidden) {
          list.removeAttribute("hidden")
        } else {
          list.setAttribute("hidden", "")
        }
        btn.setAttribute("aria-expanded", String(isHidden))

        const badge = btn.querySelector(".toc__badge")
        if (badge) badge.textContent = isHidden ? "Hide" : "Show"
      })
    })
  }

  // Run on first load
  if (document.readyState !== "loading") {
    initTocToggles()
  } else {
    document.addEventListener("DOMContentLoaded", initTocToggles)
  }

  // Re-run after Astro client-side navigations (View Transitions / ClientRouter)
  document.addEventListener("astro:page-load", initTocToggles)
</script>
