---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OtherAuthors from '../../components/OtherAuthors.astro';

const STAGING = 'https://cms.usplayercheck.com';

export async function getStaticPaths() {
  const endpoint = import.meta.env.WP_GRAPHQL_URL || 'https://cms.usplayercheck.com/graphql';

  // Only strip the domain when the URL actually lives on our WP/Cloudways host.
  // External hosts (e.g. Gravatar) are left fully intact since we don't proxy those.
  const WP_HOSTS = [
    'cms.usplayercheck.com',
    'wordpress-1301750-6506622.cloudwaysapps.com',
  ];
  const mediaUrl = (u) => {
    if (!u) return u;
    try {
      const parsed = new URL(u);
      if (WP_HOSTS.includes(parsed.hostname)) {
        return parsed.pathname + parsed.search; // e.g. /wp-content/uploads/2024/08/bonnie-evans.png
      }
      return u; // e.g. Gravatar — leave untouched
    } catch {
      return u; // already relative or malformed — leave as-is
    }
  };

  // Manual avatar overrides for authors whose real photo lives in wp-content
  // rather than Gravatar. Keyed by author slug OR display name, so both
  // /author/bonnie/ and /author/bonnie-evans/ style slugs are covered.
  const AVATAR_OVERRIDES = {
    'bonnie': '/wp-content/uploads/2024/08/bonnie-evans.png',
    'bonnie-evans': '/wp-content/uploads/2024/08/bonnie-evans.png',
    'evans-bonnie': '/wp-content/uploads/2024/08/bonnie-evans.png',
    'Evans Bonnie': '/wp-content/uploads/2024/08/bonnie-evans.png',
    'Bonnie': '/wp-content/uploads/2024/08/bonnie-evans.png',

    'charlotte': '/wp-content/uploads/2025/09/charlotte-watts.png',
    'charlotte-watts': '/wp-content/uploads/2025/09/charlotte-watts.png',
    'Charlotte Watts': '/wp-content/uploads/2025/09/charlotte-watts.png',
    'Charlotte': '/wp-content/uploads/2025/09/charlotte-watts.png',

    'jordie': '/wp-content/uploads/2024/08/Jordie-Hillcreek.png',
    'jordie-hillcreek': '/wp-content/uploads/2024/08/Jordie-Hillcreek.png',
    'Jordie Hillcreek': '/wp-content/uploads/2024/08/Jordie-Hillcreek.png',
    'Jordie': '/wp-content/uploads/2024/08/Jordie-Hillcreek.png',

    'margaret': '/wp-content/uploads/2024/07/Margaret-Cooper-us.webp',
    'margaret-cooper': '/wp-content/uploads/2024/07/Margaret-Cooper-us.webp',
    'Margaret Cooper': '/wp-content/uploads/2024/07/Margaret-Cooper-us.webp',
    'Margaret': '/wp-content/uploads/2024/07/Margaret-Cooper-us.webp',
  };

  // Role shown under each name in the "Other Authors" carousel.
  // Keyed by slug or display name; anyone not listed gets DEFAULT_ROLE.
  const AUTHOR_ROLES = {
    'bonnie': 'Casino Researcher',
    'Evans Bonnie': 'Casino Researcher',
    'Bonnie': 'Casino Researcher',
    'charlotte': 'Fact-Checker',
    'Charlotte Watts': 'Fact-Checker',
    'Charlotte': 'Fact-Checker',
    'jordie': 'Fact-Checker',
    'Jordie Hillcreek': 'Fact-Checker',
    'Jordie': 'Fact-Checker',
    'margaret': 'Senior Fact-Checker',
    'Margaret Cooper': 'Senior Fact-Checker',
    'Margaret': 'Senior Fact-Checker',
    'Kayla McBrien': 'Senior Casino Analyst',
  };
  const DEFAULT_ROLE = 'Casino Writer';

  // Accounts that should never appear in the carousel (admins, test users…)
  const EXCLUDE_FROM_CAROUSEL = ['admin', 'administrator', 'editor'];

  // Upgrade Gravatar URLs to a larger size so the tall cards stay sharp;
  // swap the grey "mystery man" default for a generated initials avatar.
  const isMysteryMan = (u) => !u || /mystery-man|[?&]d=mm\b/i.test(u);
  const bigAvatar = (u) =>
    /gravatar\.com\/avatar/i.test(u) ? u.replace(/([?&])s=\d+/, '$1s=400') : u;
  const initialsAvatar = (name) =>
    `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&size=400&background=1a233a&color=fff&bold=true`;

  async function fetchAuthors() {
    const users = [];
    let after = null;
    for (let i = 0; i < 50; i++) {
      const query = `query($after: String) {
        users(first: 50, after: $after) {
          pageInfo { hasNextPage endCursor }
          nodes {
            name slug uri description
            avatar { url }
            posts(first: 100) {
              nodes {
                title uri slug date
                featuredImage { node { sourceUrl altText } }
                categories(first: 1) { nodes { name } }
              }
            }
          }
        }
      }`;
      let json;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query, variables: { after } }),
        });
        json = await res.json();
      } catch (e) { console.error('[wp] author network error:', e); break; }
      if (json.errors) { console.error('[wp] author GraphQL errors:', JSON.stringify(json.errors, null, 2)); break; }
      const conn = json.data?.users;
      if (!conn) break;
      users.push(...(conn.nodes ?? []));
      if (!conn.pageInfo?.hasNextPage) break;
      after = conn.pageInfo.endCursor;
    }
    return users;
  }

  const users = await fetchAuthors();
  console.log('[wp] fetched authors:', users.length);

  const clean = (uri, slug) =>
    (uri || `/author/${slug}/`).replace(/^\/+|\/+$/g, '').replace(/^author\//, '');

  const resolveAvatar = (slug, name, raw) => {
    const override = AVATAR_OVERRIDES[slug] ?? AVATAR_OVERRIDES[name];
    if (override) return override;
    if (isMysteryMan(raw)) return null;
    return mediaUrl(raw);
  };

  // Build the shared "team" list once, used by every author page's carousel
  const teamAuthors = users
    .map((u) => {
      const slug = clean(u.uri, u.slug);
      if (!slug || !u.name) return null;
      if (EXCLUDE_FROM_CAROUSEL.includes(slug.toLowerCase())) return null;
      if (EXCLUDE_FROM_CAROUSEL.includes(u.name.toLowerCase())) return null;
      const avatar = resolveAvatar(slug, u.name, u.avatar?.url);
      return {
        name: u.name,
        slug,
        href: `/author/${slug}/`,
        avatar: avatar ? bigAvatar(avatar) : initialsAvatar(u.name),
        role: AUTHOR_ROLES[slug] ?? AUTHOR_ROLES[u.name] ?? DEFAULT_ROLE,
      };
    })
    .filter(Boolean);

  const paths = [];
  for (const u of users) {
    const slug = clean(u.uri, u.slug);
    if (!slug) continue;
    const posts = (u.posts?.nodes ?? []).map((p) => ({
      title: p.title,
      href: '/' + (p.uri || `/${p.slug}/`).replace(/^\/+|\/+$/g, '') + '/',
      img: mediaUrl(p.featuredImage?.node?.sourceUrl ?? null),
      alt: p.featuredImage?.node?.altText ?? p.title,
      cat: p.categories?.nodes?.[0]?.name ?? 'News',
    }));
    paths.push({
      params: { slug },
      props: {
        name: u.name,
        slug,
        bio: u.description ?? '',
        avatar: resolveAvatar(slug, u.name, u.avatar?.url) ?? initialsAvatar(u.name),
        posts,
        teamAuthors,
      },
    });
  }
  return paths;
}

const { name, slug, bio, avatar, posts, teamAuthors = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name,
    ...(bio ? { description: bio } : {}),
    ...(avatar ? { image: avatar } : {}),
    url: canonical,
  },
};
---

<Layout title={`${name} – US Player Check`} description={bio ? bio.slice(0, 155) : `Articles by ${name} on US Player Check.`} image={avatar ?? '/og-default.png'}>
  <Nav />
<Breadcrumbs items={[ { label: 'Home', href: '/' }, { label: 'Authors' }, { label: name } ]} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <header class="ahero">
    <div class="wrap ahero__inner">
      {avatar && <img class="ahero__avatar" src={avatar} alt={name} width="96" height="96" loading="lazy" />}
      <div class="ahero__text">
        <span class="ahero__ey">Author</span>
        <h1 class="ahero__name">{name}</h1>
        {bio && <p class="ahero__bio">{bio}</p>}
      </div>
    </div>
  </header>

  <section class="wrap alist">
    <h2 class="alist__head">Articles by {name}</h2>
    {posts.length === 0 ? (
      <p class="alist__empty">No articles yet.</p>
    ) : (
      <div class="space-news-3-items">
        {posts.map((p) => (
          <div class="space-news-3-item">
            <div class="space-news-3-item-ins">
              <a href={p.href} class="space-news-3-item-img">
                <div class="space-news-3-item-img-ins">
                  {p.img && <img src={p.img} alt={p.alt} loading="lazy" />}
                </div>
              </a>
              <div class="space-news-3-item-title-box">
                {p.cat && <div class="space-news-3-item-img-category"><span>{p.cat}</span></div>}
                <div class="space-news-3-item-title"><a href={p.href}>{p.title}</a></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  {/* OTHER AUTHORS — every author except the one on this page */}
  <OtherAuthors authors={teamAuthors} excludeSlug={slug} />

  <Footer />
</Layout>

<style>
  .ahero { background: aliceblue; border-bottom: 1px solid var(--line); padding-block: clamp(36px, 5vw, 60px); }
  .ahero__inner { display: flex; gap: 22px; align-items: center; }
  .ahero__avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; flex: none; border: 3px solid var(--white); box-shadow: var(--shadow-sm); }
  .ahero__ey { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-deep); }
  .ahero__name { font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.025em; color: var(--ink); margin: 6px 0 0; }
  .ahero__bio { margin-top: 12px; font-size: 14.5px; line-height: 1.65; color: var(--muted); max-width: 70ch; }

  .alist { padding-block: clamp(36px, 5vw, 56px); }
  .alist__head { font-size: 20px; color: var(--ink); margin-bottom: 22px; }
  .alist__empty { text-align: center; color: var(--muted); padding: 40px 0; }

  @media (max-width: 600px) {
    .ahero__inner { flex-direction: column; text-align: center; }
    .ahero__bio { text-align: left; }
  }
</style>