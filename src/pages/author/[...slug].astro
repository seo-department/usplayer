---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const STAGING = 'https://wordpress-1301750-6506622.cloudwaysapps.com';

export async function getStaticPaths() {
  const endpoint = import.meta.env.WP_GRAPHQL_URL;
  if (!endpoint) { console.warn('[wp] WP_GRAPHQL_URL is not set'); return []; }

  const STAGING = 'https://wordpress-1301750-6506622.cloudwaysapps.com';
  const MEDIA = (import.meta.env.WP_MEDIA_URL || STAGING).replace(/\/$/, '');
  const mediaUrl = (u) => (u ? u.replaceAll(STAGING, MEDIA) : u);

  async function fetchAuthors() {
    const users = [];
    let after = null;
    for (let i = 0; i < 50; i++) {
      const query = `query($after: String) {
        users(first: 50, after: $after) {
          pageInfo { hasNextPage endCursor }
          nodes {
            name slug uri description
            avatar { url }
            posts(first: 100) {
              nodes {
                title uri slug date
                featuredImage { node { sourceUrl altText } }
                categories(first: 1) { nodes { name } }
              }
            }
          }
        }
      }`;
      let json;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query, variables: { after } }),
        });
        json = await res.json();
      } catch (e) { console.error('[wp] author network error:', e); break; }
      if (json.errors) { console.error('[wp] author GraphQL errors:', JSON.stringify(json.errors, null, 2)); break; }
      const conn = json.data?.users;
      if (!conn) break;
      users.push(...(conn.nodes ?? []));
      if (!conn.pageInfo?.hasNextPage) break;
      after = conn.pageInfo.endCursor;
    }
    return users;
  }

  const users = await fetchAuthors();
  console.log('[wp] fetched authors:', users.length);

  const clean = (uri, slug) =>
    (uri || `/author/${slug}/`).replace(/^\/+|\/+$/g, '').replace(/^author\//, '');

  const paths = [];
  for (const u of users) {
    const slug = clean(u.uri, u.slug);
    if (!slug) continue;
    const posts = (u.posts?.nodes ?? []).map((p) => ({
      title: p.title,
      href: '/' + (p.uri || `/${p.slug}/`).replace(/^\/+|\/+$/g, '') + '/',
      img: mediaUrl(p.featuredImage?.node?.sourceUrl ?? null),
      alt: p.featuredImage?.node?.altText ?? p.title,
      cat: p.categories?.nodes?.[0]?.name ?? 'News',
    }));
    paths.push({
      params: { slug },
      props: {
        name: u.name,
        bio: u.description ?? '',
        avatar: mediaUrl(u.avatar?.url ?? null),
        posts,
      },
    });
  }
  return paths;
}

const { name, bio, avatar, posts } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name,
    ...(bio ? { description: bio } : {}),
    ...(avatar ? { image: avatar } : {}),
    url: canonical,
  },
};
---

<Layout title={`${name} – US Player Check`} description={bio ? bio.slice(0, 155) : `Articles by ${name} on US Player Check.`} image={avatar ?? '/og-default.png'}>
  <Nav />
<Breadcrumbs items={[ { label: 'Home', href: '/' }, { label: 'Authors' }, { label: name } ]} />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <header class="ahero">
    <div class="wrap ahero__inner">
      {avatar && <img class="ahero__avatar" src={avatar} alt={name} width="96" height="96" loading="lazy" />}
      <div class="ahero__text">
        <span class="ahero__ey">Author</span>
        <h1 class="ahero__name">{name}</h1>
        {bio && <p class="ahero__bio">{bio}</p>}
      </div>
    </div>
  </header>

  <section class="wrap alist">
    <h2 class="alist__head">Articles by {name}</h2>
    {posts.length === 0 ? (
      <p class="alist__empty">No articles yet.</p>
    ) : (
      <div class="space-news-3-items">
        {posts.map((p) => (
          <div class="space-news-3-item">
            <div class="space-news-3-item-ins">
              <a href={p.href} class="space-news-3-item-img">
                <div class="space-news-3-item-img-ins">
                  {p.img && <img src={p.img} alt={p.alt} loading="lazy" />}
                </div>
              </a>
              <div class="space-news-3-item-title-box">
                {p.cat && <div class="space-news-3-item-img-category"><span>{p.cat}</span></div>}
                <div class="space-news-3-item-title"><a href={p.href}>{p.title}</a></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <Footer />
</Layout>

<style>
  .ahero { background: aliceblue; border-bottom: 1px solid var(--line); padding-block: clamp(36px, 5vw, 60px); }
  .ahero__inner { display: flex; gap: 22px; align-items: center; }
  .ahero__avatar { width: 96px; height: 96px; border-radius: 50%; object-fit: cover; flex: none; border: 3px solid var(--white); box-shadow: var(--shadow-sm); }
  .ahero__ey { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-deep); }
  .ahero__name { font-size: clamp(28px, 4vw, 44px); letter-spacing: -0.025em; color: var(--ink); margin: 6px 0 0; }
  .ahero__bio { margin-top: 12px; font-size: 14.5px; line-height: 1.65; color: var(--muted); max-width: 70ch; }

  .alist { padding-block: clamp(36px, 5vw, 56px); }
  .alist__head { font-size: 20px; color: var(--ink); margin-bottom: 22px; }
  .alist__empty { text-align: center; color: var(--muted); padding: 40px 0; }

  @media (max-width: 600px) {
    .ahero__inner { flex-direction: column; text-align: center; }
    .ahero__bio { text-align: left; }
  }
</style>