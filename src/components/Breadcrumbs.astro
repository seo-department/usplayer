---
// Pass an array of { label, href } crumbs. The last one renders as plain text (current page).
const { items = [] } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, Astro.site).toString() } : {}),
  })),
};
---

{items.length > 1 && (
  <nav class="crumbs" aria-label="Breadcrumb">
    <div class="wrap">
      <ol>
        {items.map((c, i) => (
          <li>
            {c.href && i < items.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
            {i < items.length - 1 && <span class="crumbs__sep" aria-hidden="true">/</span>}
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .crumbs { background: var(--white); border-bottom: 1px solid var(--line); }
  .crumbs ol { list-style: none; margin: 0; padding: 12px 0; display: flex; flex-wrap: wrap; align-items: center; font-size: 13px; }
  .crumbs li { display: inline-flex; align-items: center; }
  .crumbs a { color: var(--emerald-2); font-weight: 600; text-decoration: none; }
  .crumbs a:hover { color: var(--emerald); text-decoration: underline; }
  .crumbs span[aria-current] { color: var(--muted); }
  .crumbs__sep { margin: 0 9px; color: var(--line-2); }
</style>