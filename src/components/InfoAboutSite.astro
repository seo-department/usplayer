---
const metrics = [
  { k: "Game selection", v: "Variety from certified providers." },
  { k: "Bonus value", v: "Realistic wagering requirements and fair terms." },
  { k: "Banking", v: "Reliability of deposit and withdrawal options." },
  { k: "Support", v: "Efficiency of customer service channels." },
  { k: "Security", v: "Active licensing and data protection protocols." },
]

const arrow =
  '<svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true"><path d="M3 9h11M10 4.5L14.5 9 10 13.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>'

const icons = {
  medal:
    '<circle cx="14" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M11 5L8 1M17 5l3-4M10.5 16.5L8.5 23l5.5-3 5.5 3-2-6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M11.5 11l1.7 1.7 3.3-3.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  shield:
    '<path d="M12 2l8 3v6.5c0 5-3.4 8.8-8 10.5-4.6-1.7-8-5.5-8-10.5V5l8-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.3 12l2.6 2.6 4.8-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',

  life: '<circle cx="13" cy="13" r="10" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="13" cy="13" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M13 3v6M13 17v6M3 13h6M17 13h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',

  book: '<path d="M4 4h6.5a3 3 0 013 3v15.5a2 2 0 00-2-2H4V4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M22 4h-6.5a3 3 0 00-3 3v15.5a2 2 0 012-2H22V4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>'

}

---

<section class="info section" id="info">
  <div class="wrap">
    <header class="info__head">
      <span class="eyebrow">About this site</span>
      <h2 class="info__title">Why trust <span>US Player Check</span></h2>
      <p class="info__sub">
        Our team publishes honest online casino reviews derived from direct
        testing. We verify payout times, bonus terms, and game fairness before
        recommending any operator — and only feature trusted casinos with
        verified licenses and robust security.
      </p>
      <p class="info__sub">
        We feature trusted online casinos with verified licenses and robust
        security. You can review our internal casino evaluation process and
        selection criteria for further transparency.
      </p>
    </header>

    <div class="info__grid">
      <article class="icard">
        <span
          class="icard__icon"
          set:html={`<svg viewBox="0 0 26 26" width="28" height="28">${icons.book}</svg>`}
        />
        <h3 class="icard__title">Explore online casino resources</h3>
        <p class="icard__body">
          Our guides simplify the complexities of digital gaming, from technical
          payment processing to bonus mechanics.
        </p>
        <ul class="metrics">
          <li>
            <span class="metrics__mark" aria-hidden="true"></span>
            <span
              ><strong>Casino Games:</strong> Learn the rules and strategies for
              popular games (including slots, blackjack, and roulette) in our real
              money casino games guide.</span
            >
          </li>
          <li>
            <span class="metrics__mark" aria-hidden="true"></span>
            <span
              ><strong>Payments:</strong> Compare casino payment methods, processing
              speeds, and withdrawal limits in our online casino payment guide.</span
            >
          </li>
          <li>
            <span class="metrics__mark" aria-hidden="true"></span>
            <span
              ><strong>Bonuses:</strong> Identify the best casino bonuses and understand
              the mechanics of free spins and turnover requirements.</span
            >
          </li>
        </ul>
        <a class="icard__link" href="/casino-reviews/"
          >Browse all guides<span set:html={arrow} /></a
        >
      </article>

      <article class="icard icard--rate">
        <span
          class="icard__icon"
          set:html={`<svg viewBox="0 0 26 26" width="28" height="28">${icons.medal}</svg>`}
        />
        <h3 class="icard__title">How we rate online casinos</h3>
        <p class="icard__body">
          Our rating system ranks casinos on five primary performance metrics:
        </p>
        <ul class="metrics">
          {
            metrics.map(m => (
              <li>
                <span class="metrics__mark" aria-hidden="true" />
                <span>
                  <strong>{m.k}:</strong> {m.v}
                </span>
              </li>
            ))
          }
        </ul>
        <a class="icard__link" href="/how-we-rate/"
          >See our full methodology<span set:html={arrow} /></a
        >
      </article>

      <article class="icard">
        <span
          class="icard__icon"
          set:html={`<svg viewBox="0 0 26 26" width="28" height="28">${icons.shield}</svg>`}
        />
        <h3 class="icard__title">Safe &amp; secure online gambling</h3>
        <p class="icard__body">
          Playing at a safe online casino is a requirement for financial
          security. We only recommend sites using secure encryption, licensed
          platforms, and RNG-tested (Random Number Generator) games to maintain
          fairness.
        </p>
        <a class="icard__link" href="/casino-safety/"
          >Safe online gambling practices<span set:html={arrow} /></a
        >
      </article>

    
    </div>
  </div>
</section>

<style>
  .info {
    background: var(--ivory-2);
    border-block: 1px solid var(--line);
  }
  .info__head {
    margin-bottom: 34px;
    max-width: 70ch;
  }
  .info__title {
    font-size: clamp(28px, 3.6vw, 44px);
    margin-top: 12px;
  }
  .info__title span {
    color: var(--gold-deep);
    font-style: italic;
  }
  .info__sub {
    margin-top: 16px;
    font-size: 15.5px;
    color: var(--muted);
    line-height: 1.65;
  }

  .info__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: start;
  }

  .icard--full {
    grid-column: 1 / -1;
  }
  .metrics--cols {
    grid-template-columns: repeat(3, 1fr);
    gap: 18px 28px;
    margin-top: 18px;
  }

  @media (max-width: 880px) {
    .metrics--cols {
      grid-template-columns: 1fr;
    }
  }

  .icard {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .icard:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .icard--rate {
    border-color: var(--gold);
    box-shadow:
      0 0 0 1px var(--gold) inset,
      var(--shadow-md);
    background: linear-gradient(180deg, #fffdf7, var(--white));
  }
  .icard__icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--emerald);
    color: var(--gold-2);
    margin-bottom: 18px;
  }
  .icard__title {
    font-size: 21px;
    color: var(--emerald);
    line-height: 1.15;
  }
  .icard__body {
    margin-top: 12px;
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.65;
  }

  .metrics {
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    display: grid;
    gap: 9px;
  }
  .metrics li {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.5;
  }
  .metrics strong {
    color: var(--emerald);
    font-weight: 600;
  }
  .metrics__mark {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    margin-top: 7px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--gold-2), var(--gold));
    transform: rotate(45deg);
  }

  .icard__link {
    margin-top: auto;
    padding-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--body);
    font-weight: 600;
    font-size: 14px;
    color: var(--emerald-2);
  }
  .icard__link :global(svg) {
    transition: transform 0.18s ease;
  }
  .icard__link:hover {
    color: var(--emerald);
  }
  .icard__link:hover :global(svg) {
    transform: translateX(3px);
  }

  @media (max-width: 880px) {
    .info__grid {
      grid-template-columns: 1fr;
      max-width: 560px;
    }
  }

  .info__head[data-astro-cid-wjjnpf47] {
    max-width: 100% !important;
  }
</style>
