---
interface Props {
  authorName?: string | null
  authorAvatar?: string | null
  authorBio?: string | null
  authorSlug?: string | null
  socials?: { network: string; url: string }[]
}

const {
  authorName = null,
  authorAvatar = null,
  authorBio = null,
  authorSlug = null,
  socials = [],
} = Astro.props

const socialIcon: Record<string, string> = {
  website:
    '<path d="M12 3a9 9 0 100 18 9 9 0 000-18zM3 12h18M12 3c2.5 2.5 2.5 15.5 0 18M12 3c-2.5 2.5-2.5 15.5 0 18" fill="none" stroke="currentColor" stroke-width="1.6"/>',
  twitter:
    '<path d="M4 4l7 9-7 7h2.5l5.5-5.5L16 20h4l-7.3-9.4L19.5 4H17l-5 5L8 4z" fill="currentColor"/>',
  facebook:
    '<path d="M14 7h2V4h-2.5C11 4 10 5.6 10 7.5V9H8v3h2v8h3v-8h2.2l.8-3H13V7.6c0-.4.3-.6.7-.6z" fill="currentColor"/>',
  linkedin:
    '<path d="M6 9v9M6 6v.01M10 18v-5a2 2 0 014 0v5M10 12v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
}

const cols = [
  {
    title: "Player Guides",
    links: [
      {
        label: "Responsible Gambling",
        href: "/responsible-gambling/",
      },
      {
        label: "Gambling Laws",
        href: "/us-gambling-laws/",
      },
      {
        label: "Gambling Addiction",
        href: "/gambling-addiction/",
      },
      {
        label: "Sitemap",
        href: "/sitemap/",
      },
      {
        label: "Casino News",
        href: "/news/",
      },
    ],
  },
  {
    title: "More Guides",
    links: [
      { label: "Privacy Policy", href: "/privacy-policy/" },
      { label: "Editorial Policy", href: "/editorial-policy/" },
      { label: "Advertising Policy", href: "/advertising-disclosure/" },
      { label: "About US", href: "/about-us/" },
    ],
  },
]

// Logos instead of text badges — drop the actual files into /public/images/partners/
const partners = [
  { name: "18plus", logo: "/wp-content/uploads/2026/07/18plus-logo.png" },
  {
    name: "gamblinghelponline",
    logo: "/wp-content/uploads/2026/07/gamblinghelponline.png",
  },
  { name: "DMCA", logo: "/wp-content/uploads/2026/07/dmca_premi_badge_4.png" },
  {
    name: "GambleAware",
    logo: "/wp-content/uploads/2026/07/gambleraware.webp",
  },
  { name: "eCOGRA", logo: "/wp-content/uploads/2026/07/ecogra.webp" },
  {
    name: "Trust Pilot",
    logo: "/wp-content/uploads/2026/07/trustpilot-wht.png",
    href: "https://www.trustpilot.com/review/usplayercheck.com",
  },
]

const year = new Date().getFullYear()
---

{
  authorName && (
    <section class="site-trust-section">
      <div class="wrap site-trust-container">
        <div class="site-author-card">
          {authorAvatar && (
            <img
              src={authorAvatar}
              alt={authorName}
              class="site-author-avatar"
              referrerpolicy="no-referrer"
            />
          )}
          <div class="site-author-info">
            <h3 class="site-author-name">
              {authorSlug ? (
                <a href={`/about-us/${authorSlug}/`}>{authorName}</a>
              ) : (
                authorName
              )}
            </h3>
            {authorBio && <p class="site-author-bio">{authorBio}</p>}
            {socials.length > 0 && (
              <div class="site-author-socials">
                {socials.map(s => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener"
                    aria-label={s.network}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      set:html={socialIcon[s.network] ?? socialIcon.website}
                    />
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>

        <div class="site-trust-statement">
          <p>
            US Player Check delivers real money online casino reviews,
            comparisons, and payout data that US players can actually rely on.
            Our team backs every review with real deposits, real withdrawals,
            and over a decade of experience testing the US market. Coverage
            focuses on regulated states like New Jersey, Pennsylvania, Michigan,
            and Connecticut. We're committed to clear, honest, and independently
            tested coverage of online casinos in the United States.
          </p>
        </div>
      </div>
    </section>
  )
}

<footer class="foot">
  <div class="wrap">
    <div class="foot__rg">
      <div class="foot__rg-mark" aria-hidden="true">18+</div>
      <p>
        Gambling can be addictive. Please play responsibly and only bet what you
        can afford to lose. If gambling is affecting you or someone you know,
        free confidential help is available 24/7 from the National Council on
        Problem Gambling — call or text the National Problem Gambling Helpline
        at
        <a href="https://www.1800gambler.net/" target="_blank">1-800-GAMBLER</a
        >.
      </p>
    </div>

    <div class="foot__top">
      <div class="foot__brand">
        <a class="brand" href="/" aria-label="US Player Check home">
          <span class="brand__name"
            ><img
              src="/images/usplayercheck-blue_logo.png"
              title="US Play Logo"
              alt="US Play Logo"
            /></span
          >
        </a>
        <p class="foot__tag">
          The information provided on USPlayerCheck.com is for informational
          purposes only. Online gambling laws and regulations may vary by
          jurisdiction, and it is the reader’s responsibility to ensure
          compliance with all applicable laws.
        </p>

        <p class="foot__tag">
          <b>Address: 3 Pacific St. Oklahoma City, OK 73127</b>
        </p>

        <ul
          class="foot__partners"
          aria-label="Licensing and safer-gambling bodies"
        >
          {
            partners.map(p => (
              <li>
                {p.href ? (
                  <a href={p.href} target="_blank" rel="noopener noreferrer">
                    <img src={p.logo} alt={p.name} loading="lazy" />
                  </a>
                ) : (
                  <img src={p.logo} alt={p.name} loading="lazy" />
                )}
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="foot__cols" aria-label="Footer">
        {
          cols.map(col => (
            <div class="foot__col">
              <strong>{col.title}</strong>
              <ul>
                {col.links.map(l => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="foot__legal">
      <p>
        © {year} US Player Check. US Player Check is an independent comparison service
        and is not a gambling operator. We may earn a commission from operators listed
        on this site, at no cost to you. This never influences our ratings. 21+ where
        required by local law. Void where prohibited.
      </p>
      <ul class="foot__legal-links">
        <li><a href="/privacy-policy/">Privacy</a></li>
        <li><a href="/responsible-gambling/">Responsible Gambling</a></li>
        <li><a href="/gambling-addiction/">Gambling Addiction</a></li>
        <li><a href="/dmca/">DMCA</a></li>
        <li>
          href="https://www.trustpilot.com/review/usplayercheck.com"
          target="_blank" rel="noopener noreferrer">Trustpilot
        </li>
      </ul>
      <li><a href="/sitemap/">Sitemap</a></li>
    </div>
  </div>
</footer>

<style>
  .site-trust-section {
    background: var(--ivory-2);
    padding: 48px 20px;
    border-top: 1px solid var(--line);
  }
  .site-trust-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .site-author-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 4px solid var(--emerald);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
    box-shadow: var(--shadow-sm);
  }
  .site-author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 3px solid var(--ivory);
    box-shadow: var(--shadow-sm);
  }
  .site-author-info {
    flex: 1;
    min-width: 0;
  }
  .site-author-name {
    margin: 0 0 12px 0;
    font-size: 1.3rem;
    font-weight: 700;
  }
  .site-author-name a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .site-author-name a:hover {
    color: var(--emerald-2);
  }
  .site-author-bio {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 16px 0;
  }
  .site-author-socials {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .site-author-socials a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ivory);
    color: var(--muted);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  .site-author-socials a:hover {
    background: var(--emerald);
    color: #fff;
    transform: translateY(-2px);
  }
  .site-trust-statement {
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 4px solid var(--emerald-2);
    border-radius: var(--radius);
    padding: 24px 28px;
  }
  .site-trust-statement p {
    margin: 0;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.75;
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .site-author-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .site-author-socials {
      justify-content: center;
    }
  }

  .foot {
    background: var(--emerald);
    color: rgba(255, 255, 255, 0.82);
    padding-top: 48px;
  }

  .foot__rg {
    display: flex;
    align-items: center;
    gap: 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(228, 203, 134, 0.22);
    border-radius: var(--radius);
    padding: 18px 22px;
    margin-bottom: 48px;
  }
  .foot__rg-mark {
    flex: 0 0 auto;
    font-weight: 700;
    font-size: 17px;
    color: var(--emerald);
    background: var(--gold-2);
    border-radius: 10px;
    padding: 10px 12px;
    letter-spacing: 0.02em;
  }
  .foot__rg p {
    font-size: 13.5px;
    line-height: 1.55;
  }
  .foot__rg a {
    color: var(--gold-2);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .foot__top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: 44px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .foot .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .foot .brand__name {
    color: #fff;
    display: flex;
    align-items: center;
  }
  .foot .brand__name img {
    display: block;
    height: 32px;
    width: auto;
  }

  .foot__tag {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.6;
    max-width: 34ch;
    color: rgba(255, 255, 255, 0.72);
  }

  .foot__partners {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .foot__partners li {
    display: flex;
    align-items: center;
    border-radius: 6px;
    padding: 6px 10px;
  }
  .foot__partners img {
    height: 20px;
    width: auto;
    display: block;
  }

  .foot__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .foot__col strong {
    font-family: var(--body);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-bottom: 14px;
  }
  .foot__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .foot__col a {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.78);
    transition: color 0.15s ease;
  }
  .foot__col a:hover {
    color: #fff;
  }

  .foot__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding-block: 26px 40px;
  }
  .foot__legal p {
    font-size: 12px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
    max-width: 70ch;
  }
  .foot__legal-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding: 0;
    margin: 0;
  }
  .foot__legal-links a {
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.7);
  }
  .foot__legal-links a:hover {
    color: var(--gold-2);
  }

  @media (max-width: 860px) {
    .foot__top {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .foot__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 460px) {
    .foot__cols {
      grid-template-columns: 1fr;
    }
    .foot__rg {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
