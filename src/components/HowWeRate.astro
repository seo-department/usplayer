---
const criteria = [
  {
    n: '01',
    title: 'We deposit real money',
    body: 'Every casino on US Player Check is funded from our own pocket. No demo accounts, no operator-supplied logins — we play the games you would.',
    weight: '30%',
    label: 'Trust & licensing',
  },
  {
    n: '02',
    title: 'We cash out and time it',
    body: 'We request a withdrawal within 48 hours and clock how long the money actually takes to land, across cards, e-wallets and crypto.',
    weight: '25%',
    label: 'Payout speed',
  },
  {
    n: '03',
    title: 'We read the fine print',
    body: 'Wagering requirements, game weighting and max-bet rules decide whether a bonus is generous or a trap. We translate it into plain numbers.',
    weight: '25%',
    label: 'Bonus value',
  },
  {
    n: '04',
    title: 'We count what’s playable',
    body: 'Library size, studio quality and live-table range, checked against what’s available in your region — not just the marketing total.',
    weight: '20%',
    label: 'Game range',
  },
];
---

<section class="method section" id="method">
  <div class="wrap method__grid">
    <div class="method__intro">
      <span class="eyebrow">Our scoring method</span>
      <h2 class="method__title">A 9.7 has to be&nbsp;earned</h2>
      <p>
        Every score is built from four weighted tests we run ourselves. The
        weights are fixed and public, so two casinos are never measured by a
        different ruler.
      </p>
      <div class="method__weights" aria-hidden="true">
        {criteria.map((c) => (
          <div class="wbar">
            <span class="wbar__label">{c.label}</span>
            <span class="wbar__track"><span class="wbar__fill" style={`width:${c.weight}`}></span></span>
            <span class="wbar__val">{c.weight}</span>
          </div>
        ))}
      </div>
    </div>

    <ol class="method__steps">
      {criteria.map((c) => (
        <li class="mstep">
          <span class="mstep__n">{c.n}</span>
          <div>
            <h3 class="mstep__title">{c.title}</h3>
            <p class="mstep__body">{c.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method { background: var(--ivory-2); border-block: 1px solid var(--line); }
  .method__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(36px, 6vw, 84px);
    align-items: start;
  }

  .method__title {
    font-size: clamp(28px, 3.6vw, 44px);
    margin-top: 14px;
  }
  .method__intro p {
    margin-top: 18px;
    color: var(--muted);
    font-size: 15.5px;
    max-width: 40ch;
  }

  .method__weights { margin-top: 30px; display: grid; gap: 12px; }
  .wbar {
    display: grid;
    grid-template-columns: 130px 1fr 42px;
    align-items: center;
    gap: 12px;
  }
  .wbar__label { font-size: 13px; font-weight: 600; color: var(--ink); }
  .wbar__track {
    height: 7px;
    background: var(--line-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .wbar__fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--emerald-2), var(--emerald-soft));
    border-radius: 999px;
  }
  .wbar__val { font-size: 13px; font-weight: 700; color: var(--emerald); text-align: right; }

  .method__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .mstep {
    background: var(--white);
    padding: 26px 24px;
    display: flex;
    gap: 16px;
  }
  .mstep__n {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 600;
    color: var(--gold);
    line-height: 1;
    flex: 0 0 auto;
  }
  .mstep__title { font-size: 18px; color: var(--emerald); }
  .mstep__body { margin-top: 8px; font-size: 14px; color: var(--muted); line-height: 1.55; }

  @media (max-width: 900px) {
    .method__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .method__steps { grid-template-columns: 1fr; }
    .wbar { grid-template-columns: 110px 1fr 40px; }
  }
</style>
