---
const items = [
  { k: 'Independently funded', v: 'We earn commissions, never ranking fees' },
  { k: 'Real-money testing', v: 'Every casino deposited & cashed out' },
  { k: 'Licence verified', v: 'MGA, UKGC & Curaçao checked monthly' },
  { k: 'Updated weekly', v: 'Scores re-checked every Monday' },
];
---

<section class="trust" aria-label="Why trust US Player Check">
  <div class="wrap trust__inner">
    {items.map((it) => (
      <div class="trust__item">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path d="M10 1.5l6.5 2.4v5.2c0 4-2.7 7-6.5 8.4-3.8-1.4-6.5-4.4-6.5-8.4V3.9L10 1.5z"
                fill="none" stroke="#C8A24B" stroke-width="1.4" stroke-linejoin="round"/>
          <path d="M6.6 10l2.3 2.3 4.5-4.8" fill="none" stroke="#E4CB86" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div>
          <strong>{it.k}</strong>
          <span>{it.v}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .trust {
    background: var(--emerald);
    color: #fff;
  }
  .trust__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    padding-block: 0;
  }
  .trust__item {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 26px clamp(14px, 2vw, 26px);
    position: relative;
  }
  .trust__item:not(:last-child)::after {
    content: "";
    position: absolute;
    right: 0; top: 22%;
    height: 56%;
    width: 1px;
    background: rgba(228,203,134,.22);
  }
  .trust__item strong {
    display: block;
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    color: var(--gold-2);
  }
  .trust__item span {
    display: block;
    font-size: 13px;
    color: rgba(255,255,255,.78);
    margin-top: 3px;
    line-height: 1.45;
  }
  @media (max-width: 860px) {
    .trust__inner { grid-template-columns: 1fr 1fr; }
    .trust__item:nth-child(2)::after { display: none; }
  }
  @media (max-width: 480px) {
    .trust__inner { grid-template-columns: 1fr; }
    .trust__item::after { display: none !important; }
    .trust__item { border-bottom: 1px solid rgba(228,203,134,.18); }
  }
</style>
