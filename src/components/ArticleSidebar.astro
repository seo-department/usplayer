---
// src/components/ArticleSidebar.astro
interface Props {
  tocItems?: { text: string; slug: string }[]
  showMission?: boolean
}
const { tocItems = [], showMission = true } = Astro.props
---

<aside class="asb" aria-label="Sidebar">
  {showMission && (
    <section class="asb-card asb-mission">
      <h2 class="asb-mission__head">
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
          <path d="M12 2l8 3v6.5c0 5-3.4 8.8-8 10.5-4.6-1.7-8-5.5-8-10.5V5l8-3z" fill="currentColor" />
        </svg>
        Mission statement
      </h2>
      <div class="asb-mission__body">
        <p class="asb-mission__lead">
          US Player Check is America's independent guide to legal, real money online casinos
        </p>
        <ul class="asb-mission__list">
          <li>Reviews written and fact-checked by US iGaming specialists</li>
          <li>Data-driven ratings, bonus and payout analysis</li>
          <li>Transparent editorial standards on every review</li>
        </ul>
        <a class="asb-mission__btn" href="/about-us/">About us</a>
      </div>
    </section>
  )}

  {tocItems.length > 0 && (
    <nav class="asb-card asb-toc" aria-label="Table of contents">
      <h2 class="asb-toc__head">
        <span class="asb-toc__flag" aria-hidden="true"></span>
        Table of contents
      </h2>
      <ul class="asb-toc__list">
        {tocItems.map(item => (
          <li>
            <a href={`#${item.slug}`} data-toc-link={item.slug}>{item.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</aside>

<style>
  .asb {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-self: stretch; /* lets the TOC card stick for the full article height */
  }
  .asb-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  /* ---- Mission statement ---- */
  .asb-mission {
    overflow: hidden;
  }
  .asb-mission__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 11px 18px;
    background: var(--emerald);
    color: #fff;
    font-family: var(--body);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .asb-mission__head svg {
    color: var(--gold-2);
  }
  .asb-mission__body {
    padding: 18px;
  }
  .asb-mission__lead {
    margin: 0 0 14px;
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--ink);
  }
  .asb-mission__list {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .asb-mission__list li {
    position: relative;
    padding-left: 24px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .asb-mission__list li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 4px;
    width: 12px;
    height: 7px;
    border-left: 2px solid #2e9e6b;
    border-bottom: 2px solid #2e9e6b;
    transform: rotate(-45deg);
  }
  .asb-mission__btn {
    display: block;
    text-align: center;
    padding: 10px 14px;
    border: 1.5px solid var(--emerald);
    border-radius: 8px;
    color: var(--emerald);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .asb-mission__btn:hover,
  .asb-mission__btn:focus-visible {
    background: var(--emerald);
    color: #fff;
  }

  /* ---- Sticky TOC ---- */
  .asb-toc {
    position: sticky;
    top: 122px; 
    max-height: calc(100vh - 104px);
    overflow-y: auto;
    padding: 18px;
    overscroll-behavior: contain;
  }
  .asb-toc__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    padding-bottom: 12px;
    border-bottom: 1.5px solid var(--ink);
    font-family: var(--body);
    font-size: 13px;
    font-weight: 800;
    font-style: italic;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .asb-toc__flag {
    width: 18px;
    height: 9px;
    border-radius: 2px;
    background: var(--gold);
    flex: none;
  }
  .asb-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .asb-toc__list li + li {
    border-top: 1px solid var(--line);
  }
  .asb-toc__list a {
    display: block;
    padding: 9px 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .asb-toc__list a:hover {
    color: var(--emerald-2);
  }
  .asb-toc__list a.is-active {
    color: var(--emerald);
    font-weight: 700;
    font-size: 14.5px;
  }

  /* Mobile: the collapsible TOC above the content takes over */
  @media (max-width: 960px) {
    .asb-toc {
      display: none;
    }
  }
</style>

<script>
  function initTocSpy() {
    // Clean up any listener from a previous page (View Transitions)
    if (window.__tocSpyCleanup) window.__tocSpyCleanup()

    const links = [...document.querySelectorAll<HTMLAnchorElement>(".asb-toc a[data-toc-link]")]
    if (!links.length) return

    const heads = links
      .map(a => document.getElementById(a.dataset.tocLink!))
      .filter((h): h is HTMLElement => !!h)
    if (!heads.length) return

    const box = document.querySelector<HTMLElement>(".asb-toc")
    const OFFSET = 120
    let ticking = false
    let currentId = ""

    const update = () => {
      ticking = false
      let id = heads[0].id
      for (const h of heads) {
        if (h.getBoundingClientRect().top <= OFFSET) id = h.id
        else break
      }
      if (id === currentId) return
      currentId = id
      for (const a of links) {
        const on = a.dataset.tocLink === id
        a.classList.toggle("is-active", on)
        if (on) {
          a.setAttribute("aria-current", "true")
          // keep the active item visible if the TOC itself scrolls
          if (box && box.scrollHeight > box.clientHeight) {
            const top = a.offsetTop - box.clientHeight / 3
            box.scrollTo({ top, behavior: "smooth" })
          }
        } else {
          a.removeAttribute("aria-current")
        }
      }
    }

    const onScroll = () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true })
    window.addEventListener("resize", onScroll, { passive: true })
    window.__tocSpyCleanup = () => {
      window.removeEventListener("scroll", onScroll)
      window.removeEventListener("resize", onScroll)
    }
    update()
  }

  declare global {
    interface Window {
      __tocSpyCleanup?: () => void
    }
  }

  if (document.readyState !== "loading") initTocSpy()
  else document.addEventListener("DOMContentLoaded", initTocSpy)
  document.addEventListener("astro:page-load", initTocSpy)
</script>